# Same values as the ERP (Vercel > erp-proone > Environment Variables). The login is shared with the ERP through these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Production only: lets this app read the ERP login cookie. Same value as the ERP's COOKIE_DOMAIN (for example .profesoronline.id).
COOKIE_DOMAIN=
# The ERP's address, where chats are read and replies are sent. No trailing slash.
ERP_BASE_URL=https://erp.profesoronline.id
# Where people go to sign in when they are not signed in.
ERP_LOGIN_URL=https://erp.profesoronline.id/login
# Local design preview with made-up chats and no sign-in. NEVER set this on Vercel.
DEMO=
